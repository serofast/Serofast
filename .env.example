# ============================================================================
# SEROFAST HYPERLOCAL MARKETPLACE - ENVIRONMENT CREDENTIALS TEMPLATE
# Copy this file to .env and replace placeholders with your actual keys.
# DO NOT commit real API keys or passwords to version control.
# ============================================================================

# Supabase Credentials (From Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-jwt-token-here
VITE_SUPABASE_STORAGE_BUCKET=shop-assets

# Firebase Credentials (From Firebase Console -> Project Settings -> Web App)
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# Razorpay Credentials (From Razorpay Dashboard -> Settings -> API Keys)
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id

# Admin Portal Master Credentials (Used for Admin Route Access Gateway)
VITE_ADMIN_USER=admin@serofast.com
VITE_ADMIN_PASSCODE=YourStrongAdminPasscode!
VITE_ADMIN_SECURITY_CODE=202688
